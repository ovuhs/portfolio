{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/seo.js": { "includeFiles": "{config.js,content.js,index.html}", "maxDuration": 10 },
    "api/sitemap.js": { "includeFiles": "{config.js,content.js}", "maxDuration": 10 }
  },
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/(projects|skills|certifications|experience|recommendations|hobbies|contact)", "destination": "/" }
  ],
  "headers": [
    { "source": "/assets/vendor/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
