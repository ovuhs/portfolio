{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/seo.js": {
      "includeFiles": "{config.js,content.js,index.html}",
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/assets/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
